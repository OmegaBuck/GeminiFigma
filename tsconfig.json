{
    "compilerOptions": {
        "target": "ES6",
        "lib": [
            "DOM",
            "ES2020"
        ],
        "module": "ESNext",
        "moduleResolution": "node",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": [
            "@figma/plugin-typings"
        ],
        "outDir": "./dist"
    },
    "include": [
        "src/**/*"
    ]
}